# Carpeta donde se guardan las notas de las reuniones.
# macOS:
# /Users/TU_USUARIO/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian
# Windows:
# C:/Users/TU_USUARIO/Documents/Obsidian
OBSIDIAN_DIR=

# Motor: auto (Whistle en Windows x64, Whisper en macOS), whisper o whistle.
TRANSCRIPTION_ENGINE=auto

# Idioma enviado al motor seleccionado. Whistle también admite auto.
TRANSCRIPTION_LANGUAGE=es

# Compatibilidad con instalaciones anteriores: si TRANSCRIPTION_LANGUAGE no
# está definido, también se acepta WHISPER_LANGUAGE.
# WHISPER_LANGUAGE=es

# macOS usa medium por defecto; Windows usa WINDOWS_WHISPER_MODEL como respaldo.
WHISPER_MODEL=medium

# Windows usa small por defecto; define medium aquí para priorizar precisión.
WINDOWS_WHISPER_MODEL=small
# Marcadores acústicos experimentales, no identificación fiable de personas.
SPEAKER_MARKERS=false

# macOS: ganancias opcionales para cada fuente. 1.0 conserva el nivel capturado.
MAC_SYSTEM_GAIN=1.0
MAC_MICROPHONE_GAIN=1.0

# Whisper: deja true para usar detección de voz; false conserva también audio bajo.
WHISPER_VAD_FILTER=true

# Windows: deja vacías para usar los dispositivos predeterminados.
# También aceptan parte del nombre del dispositivo.
WINDOWS_MICROPHONE=
WINDOWS_SPEAKER=

# Windows: búfer WASAPI solicitado en segundos; lecturas de 50 ms.
# Windows puede usar un tamaño diferente. Aumenta a 2.0 si persisten cortes.
WINDOWS_BUFFER_SECONDS=1.0
