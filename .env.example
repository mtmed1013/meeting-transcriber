# Carpeta donde se guardan las notas de las reuniones.
# macOS:
# /Users/TU_USUARIO/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian
# Windows:
# C:/Users/TU_USUARIO/Documents/Obsidian
OBSIDIAN_DIR=

# Modelo Faster-Whisper: medium, small o tiny.
WHISPER_MODEL=medium

# macOS: ganancias opcionales para cada fuente. 1.0 conserva el nivel capturado.
MAC_SYSTEM_GAIN=1.0
MAC_MICROPHONE_GAIN=1.0

# Whisper: deja true para usar detección de voz; false conserva también audio bajo.
WHISPER_VAD_FILTER=true

# Windows: deja vacías para usar los dispositivos predeterminados.
# También aceptan parte del nombre del dispositivo.
WINDOWS_MICROPHONE=
WINDOWS_SPEAKER=
